def calculate_distance(lat1, lon1, lat2, lon2):
    """Calculate approximate distance between two coordinates in kilometers"""
    from math import radians, sin, cos, sqrt, atan2
    R = 6371.0  # Earth radius in km
    
    lat1 = radians(float(lat1))
    lon1 = radians(float(lon1))
    lat2 = radians(float(lat2))
    lon2 = radians(float(lon2))
    
    dlon = lon2 - lon1
    dlat = lat2 - lat1
    
    a = sin(dlat / 2)**2 + cos(lat1) * cos(lat2) * sin(dlon / 2)**2
    c = 2 * atan2(sqrt(a), sqrt(1 - a))
    
    return R * c

def find_nearby_hotels(site, hotels, max_distance=50):
    """Find hotels within a certain distance of a tourist site"""
    site_lat = site.get("Latitude")
    site_lon = site.get("Longitude")
    
    if not site_lat or not site_lon:
        return []
    
    nearby_hotels = []
    for hotel in hotels:
        hotel_lat = hotel.get("Latitude")
        hotel_lon = hotel.get("Longitude")
        
        if hotel_lat and hotel_lon:
            distance = calculate_distance(site_lat, site_lon, hotel_lat, hotel_lon)
            if distance <= max_distance:
                hotel_copy = hotel.copy()
                hotel_copy["Distance (km)"] = round(distance, 1)
                nearby_hotels.append(hotel_copy)
    
    return sorted(nearby_hotels, key=lambda x: x["Distance (km)"])

