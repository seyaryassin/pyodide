import csv
from datetime import datetime, timedelta

def display_as_table(data, headers):
    """Display data in table format using basic string formatting"""
    if not data:
        print("No data available")
        return
    
    # Calculate column widths
    col_widths = []
    for i, header in enumerate(headers):
        max_width = len(header)
        for row in data:
            if isinstance(row, dict):
                value = str(row.get(header, ""))
            else:
                value = str(row[i])
            max_width = max(max_width, len(value))
        col_widths.append(max_width)
    
    # Create row format string
    row_format = " | ".join([f"{{:<{w}}}" for w in col_widths])
    
    # Print header
    print(row_format.format(*headers))
    print("-" * (sum(col_widths) + 3 * (len(headers) - 1)))  # Divider line
    
    # Print rows
    for row in data:
        if isinstance(row, dict):
            values = [str(row.get(h, "")) for h in headers]
        else:
            values = [str(x) for x in row]
        print(row_format.format(*values))

def count_visits(tourist_id, visits):
    """Count number of visits for a specific tourist"""
    return sum(1 for visit in visits if visit["Tourist ID"] == tourist_id)

def certify_tourist(tourist, visit_count):
    """Certify tourist based on number of sites visited"""
    if visit_count >= 5:
        return "Gold Explorer"
    elif visit_count >= 3:
        return "Silver Explorer"
    elif visit_count >= 1:
        return "Bronze Explorer"
    else:
        return "Not Certified"

def validate_date(date_str):
    """Validate date format (YYYY-MM-DD)"""
    try:
        datetime.strptime(date_str, "%Y-%m-%d")
        return True
    except ValueError:
        return False

def validate_coordinate(coord_str, coord_type):
    """Validate latitude or longitude coordinate"""
    try:
        coord = float(coord_str)
        if coord_type == "latitude":
            return -90 <= coord <= 90
        else:  # longitude
            return -180 <= coord <= 180
    except ValueError:
        return False

def calculate_stay_duration(check_in, check_out):
    """Calculate number of days between two dates"""
    date_format = "%Y-%m-%d"
    d1 = datetime.strptime(check_in, date_format)
    d2 = datetime.strptime(check_out, date_format)
    return (d2 - d1).days

def calculate_total_price(price_per_night, nights, room_type):
    """Calculate total price based on room type and duration"""
    try:
        price = float(price_per_night)
        if room_type.lower() == "suite":
            price *= 1.5
        elif room_type.lower() == "double":
            price *= 1.2
        return round(price * nights, 2)
    except ValueError:
        return 0.0

def get_valid_input(prompt, validation_func=None, error_message="Invalid input"):
    """Get validated user input"""
    while True:
        user_input = input(prompt).strip()
        if not validation_func or validation_func(user_input):
            return user_input
        print(f"❌ {error_message}")

def select_from_table(items, display_headers, prompt):
    """Select an item from a displayed table"""
    display_as_table(items, display_headers)
    while True:
        try:
            selected_id = int(input(prompt))
            if 1 <= selected_id <= len(items):
                return items[selected_id - 1]
            print("❌ Invalid selection. Please enter a valid ID.")
        except ValueError:
            print("❌ Please enter a numeric ID.")

