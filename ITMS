                    display_as_table(visits, ["Visit ID", "Tourist Name", "Site Name", "Visit Date", "Entry Fee Paid", "Payment Method"])
                
                elif choice == "3":
                    if not visits:
                        print("\n❌ No visits to export!")
                    else:
                        filename = "visits.csv"
                        with open(filename, "w", newline="") as file:
                            writer = csv.DictWriter(file, fieldnames=visits[0].keys())
                            writer.writeheader()
                            writer.writerows(visits)
                        print(f"\n💾 Visit data exported to '{filename}' successfully!")
                
                elif choice == "4":
                    break
        
        elif main_choice == "6":  # Tourist Certification
            print("\n🏅 Tourist Certification")
            if not tourists:
                print("❌ No tourists registered yet!")
                continue
                
            print("\n👤 Select Tourist:")
            selected_tourist = select_from_table(tourists, ["ID", "Name", "Nationality"], "Enter Tourist ID: ")
            
            visit_count = count_visits(selected_tourist["ID"], visits)
            certification = certify_tourist(selected_tourist, visit_count)
            
            print(f"\n📊 Certification Report for {selected_tourist['Name']}:")
            print(f"Passport Number: {selected_tourist['Passport No']}")
            print(f"Number of Sites Visited: {visit_count}")
            print(f"Certification Level: {certification}")
            
            if visit_count > 0:
                print("\n🏆 Visited Sites:")
                visited_sites = [v for v in visits if v["Tourist ID"] == selected_tourist["ID"]]
                display_as_table(visited_sites, ["Site Name", "Visit Date", "Entry Fee Paid"])
        
        elif main_choice == "7":  # Payment Records
            print("\n💰 Payment Records")
            if not payments:
                print("No payment records available")
                continue
                
            print("\n📋 All Payment Records")
            display_as_table(payments, ["Tourist", "Site", "Amount", "Method", "Date"])
            
            total_revenue = sum(float(p["Amount"]) for p in payments)
            print(f"\n💵 Total Revenue: ${total_revenue:.2f}")
            
            # Export option
            export = input("\nExport payment records to CSV? (y/n): ").lower()
            if export == "y":
                filename = "payments.csv"
                with open(filename, "w", newline="") as file:
                    writer = csv.DictWriter(file, fieldnames=payments[0].keys())
                    writer.writeheader()
                    writer.writerows(payments)
                print(f"\n💾 Payment data exported to '{filename}' successfully!")
        
        elif main_choice == "8":  # Nearby Hotels
            print("\n🏨 Nearby Hotels for Tourist Sites")
            if not tourist_sites or not hotels:
                print("❌ Need tourist sites and hotels registered first!")
                continue
                
            print("\n🏞️ Select Site:")
            selected_site = select_from_table(tourist_sites, ["ID", "Name", "Location"], "Enter Site ID: ")
            
            max_distance = get_valid_input("\nMaximum distance in km (default 50): ",
                                         lambda x: x == "" or (x.replace('.','',1).isdigit() and float(x) > 0),
                                         "Distance must be a positive number")
            max_distance = float(max_distance) if max_distance else 50.0
            
            nearby_hotels = find_nearby_hotels(selected_site, hotels, max_distance)
            
            if not nearby_hotels:
                print(f"\n❌ No hotels found within {max_distance} km of {selected_site['Name']}")
            else:
                print(f"\n🏨 Hotels within {max_distance} km of {selected_site['Name']}:")
                display_as_table(nearby_hotels, ["Name", "Location", "Star Rating", "Base Price", "Distance (km)"])
        
        elif main_choice == "9":
            print("\n👋 Exiting the program. Goodbye!")
            break

if __name__ == "__main__":
